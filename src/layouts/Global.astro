---
import "@assets/styles/base.css";
import "@assets/styles/icons.css";
import { Font } from "astro:assets";
import Header from "@components/Header.astro";
import { ClientRouter } from "astro:transitions";
const { title, active } = Astro.props;
---

<html lang="en" class="scroll-smooth" transition:animate="fade">
	<head>
		<meta charset="utf-8" />

		<ClientRouter />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<Font cssVariable="--font-noto" preload/>
		<title>{title ? title : "barab."}</title>
		<meta name="title" content="barab. - Developer" />
		<meta
			name="description"
			content="I'm barab, an in learning developer. This website is my portfolio."
		/>
		<link rel="canonical" href="https://barab.me/" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content="barab." />
		<meta property="og:url" content="https://barab.me" />
		<meta property="og:image" content="https://barab.me/logo.png" />
		<meta
			property="og:description"
			content="I'm barab, an in learning developer. This website is my portfolio."
		/>
		<link rel="sitemap" href="/sitemap-index.xml" />
	</head>
	<body class="flex flex-col bg-[#fbffee] h-screen">
		<Header active={active || Astro.url.pathname} />
		<slot />

		<div id="spline-container" class="fixed inset-0 pointer-events-none opacity-0 transition-opacity duration-300 -z-10" transition:persist>
			<canvas id="3dhouse" class="w-full h-full"></canvas>
		</div>

		<script>
			import { Application } from "@splinetool/runtime";

			// Initialize spline once
			let isLoaded = false;
			const canvas = document.getElementById("3dhouse") as HTMLCanvasElement;
			const spline = new Application(canvas);

			spline
				.load("/house.splinecode", {
					credentials: "include",
					mode: "no-cors",
				})
				.then(async () => {
					isLoaded = true;
					window.dispatchEvent(new CustomEvent("spline-loaded"));

					try {
						var status = await (await fetch("/presence")).text();
						spline.setVariable("status", status);
					} catch (e) {
						console.error("Failed to fetch presence status:", e);
					}

					try {
						var spotify = await (await fetch("/presence/spotify")).json();
						if (spotify) {
							spline.setVariable(
								"music",
								"listening " + (spotify as any).details,
							);
						}
					} catch (e) {
						console.error("Failed to fetch spotify status:", e);
					}

					try {
						var vscode = await (await fetch("/presence/vscode")).json();
						if (vscode) {
							spline.setVariable("code", (vscode as any).details);
						}
					} catch (e) {
						console.error("Failed to fetch vscode status:", e);
					}
				});

			// Expose state for about page logic
			(window as any).isSplineLoaded = () => isLoaded;

			// Handle visibility based on route navigation
			document.addEventListener("astro:page-load", () => {
				const container = document.getElementById("spline-container");
				if (container) {
					if (window.location.pathname === "/about" || window.location.pathname === "/about/") {
						container.classList.remove("opacity-0", "pointer-events-none", "-z-10");
						container.classList.add("opacity-100", "z-10");
					} else {
						container.classList.add("opacity-0", "pointer-events-none", "-z-10");
						container.classList.remove("opacity-100", "z-10");
					}
				}
			});
		</script>
	</body>
</html>
