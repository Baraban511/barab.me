---
export const prerender = true
import Layout from "@layouts/Global.astro";
import Loading from "@components/Loading.astro";
---

<Layout title="About - barab.">
    <Loading id="loading" />
    <script>
        document.addEventListener("astro:page-load", () => {
            const removeLoading = () => {
                const loadingEl = document.getElementById("loading");
                if (loadingEl) loadingEl.remove();
            };

            // Remove loading immediately if spline is already loaded
            if ((window as any).isSplineLoaded && (window as any).isSplineLoaded()) {
                removeLoading();
            } else {
                // Otherwise wait for the spline-loaded event
                window.addEventListener("spline-loaded", removeLoading, { once: true });
            }
        });
    </script>
</Layout>
